<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The process runs with UTF-8 as its active code page (Windows 10 1903 and later), so
     narrow strings, arguments and std::filesystem::path::string() carry every character
     a path or a name may hold. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
